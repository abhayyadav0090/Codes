{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compile",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-o",
        "${fileBasenameNoExtension}",
        "${file}"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "compile and run",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/C",
        "g++ -std=c++17 -o \"${fileBasenameNoExtension}\" \"${file}\" && \"${fileBasenameNoExtension}\" < .vscode/input.txt > .vscode/output.txt && del \"${fileBasenameNoExtension}.exe\""
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
